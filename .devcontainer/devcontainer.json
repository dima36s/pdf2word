{
  "name": "PDF → Word",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-rus tesseract-ocr-osd fonts-liberation && pip install -r requirements.txt pytest httpx",
  "postAttachCommand": {
    "server": "bash .devcontainer/start.sh"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "PDF → Word", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
